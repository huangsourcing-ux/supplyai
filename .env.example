# Local Docker Compose values only. Never put staging or production secrets here.
APP_ENV=local
COMPOSE_PROJECT_NAME=chinasupply
POSTGRES_DB=chinasupply
POSTGRES_USER=chinasupply
POSTGRES_PASSWORD=chinasupply_local_only
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://chinasupply:chinasupply_local_only@127.0.0.1:5432/chinasupply
REDIS_URL=redis://127.0.0.1:6379
