{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      ".dockerignore",
      "apps/api/**",
      "Dockerfile",
      "packages/config/**",
      "packages/geo/**",
      "packages/schemas/**",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "railway.json",
      "turbo.json"
    ]
  },
  "deploy": {
    "drainingSeconds": 30,
    "restartPolicyMaxRetries": 10,
    "restartPolicyType": "ON_FAILURE"
  }
}
