{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @chinasupply/api build"
  },
  "deploy": {
    "drainingSeconds": 30,
    "restartPolicyMaxRetries": 10,
    "restartPolicyType": "ON_FAILURE",
    "startCommand": "pnpm --filter @chinasupply/api start:$SERVICE_ROLE"
  }
}
