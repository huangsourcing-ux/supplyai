{
  "version": 8,
  "name": "ChinaSupply.AI Light",
  "metadata": {
    "chinasupply:owner": "packages/config",
    "chinasupply:purpose": "Shared Web and mobile product basemap"
  },
  "glyphs": "https://api.maptiler.com/fonts/{fontstack}/{range}.pbf?key=__MAPTILER_KEY__",
  "sources": {
    "maptiler-planet": {
      "type": "vector",
      "url": "https://api.maptiler.com/tiles/v4/tiles.json?key=__MAPTILER_KEY__",
      "attribution": "<a href=\"https://www.maptiler.com/copyright/\" target=\"_blank\">© MapTiler</a> <a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\">© OpenStreetMap contributors</a>"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#F4F5F1"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "maptiler-planet",
      "source-layer": "landcover",
      "paint": {
        "fill-color": [
          "match",
          ["get", "class"],
          "wood",
          "#DDE8DA",
          "grass",
          "#E6EDDF",
          "ice",
          "#F7FAFB",
          "#EBEEE8"
        ],
        "fill-opacity": 0.7
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "maptiler-planet",
      "source-layer": "landuse",
      "minzoom": 6,
      "paint": {
        "fill-color": [
          "match",
          ["get", "class"],
          "residential",
          "#E9E9E4",
          "industrial",
          "#E7E3DD",
          "commercial",
          "#EAE4E0",
          "cemetery",
          "#DFE9DD",
          "#ECEDE8"
        ],
        "fill-opacity": 0.62
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "maptiler-planet",
      "source-layer": "water",
      "paint": {
        "fill-color": "#C9DDE8"
      }
    },
    {
      "id": "administrative-boundaries",
      "type": "line",
      "source": "maptiler-planet",
      "source-layer": "boundary",
      "filter": [
        "all",
        ["in", ["get", "admin_level"], ["literal", [2, 4]]],
        ["!=", ["get", "maritime"], 1]
      ],
      "paint": {
        "line-color": [
          "match",
          ["get", "admin_level"],
          2,
          "#78847D",
          "#A9B1AC"
        ],
        "line-dasharray": [2, 1.5],
        "line-opacity": 0.66,
        "line-width": ["interpolate", ["linear"], ["zoom"], 2, 0.65, 8, 1.2]
      }
    },
    {
      "id": "major-roads-casing",
      "type": "line",
      "source": "maptiler-planet",
      "source-layer": "transportation",
      "minzoom": 5,
      "filter": [
        "in",
        ["get", "class"],
        ["literal", ["motorway", "trunk", "primary", "secondary"]]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#D6D8D2",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 1.3, 12, 5.5]
      }
    },
    {
      "id": "major-roads",
      "type": "line",
      "source": "maptiler-planet",
      "source-layer": "transportation",
      "minzoom": 5,
      "filter": [
        "in",
        ["get", "class"],
        ["literal", ["motorway", "trunk", "primary", "secondary"]]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": [
          "match",
          ["get", "class"],
          "motorway",
          "#F8D8A6",
          "trunk",
          "#F6DFC0",
          "#F8F7F1"
        ],
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.65, 12, 3.5]
      }
    },
    {
      "id": "place-labels",
      "type": "symbol",
      "source": "maptiler-planet",
      "source-layer": "place",
      "minzoom": 2,
      "layout": {
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-letter-spacing": 0.02,
        "text-max-width": 8,
        "text-size": [
          "match",
          ["get", "class"],
          "country",
          14,
          "state",
          12,
          "province",
          12,
          "city",
          11,
          10
        ]
      },
      "paint": {
        "text-color": "#46534D",
        "text-halo-color": "#F4F5F1",
        "text-halo-width": 1.4
      }
    }
  ]
}
