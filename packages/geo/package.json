{
  "name": "@chinasupply/geo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "react-native": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./navigation": {
      "types": "./src/navigation/index.ts",
      "react-native": "./src/navigation/index.ts",
      "default": "./dist/navigation/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "lint": "eslint .",
    "navigation:validation": "tsx scripts/generate-navigation-validation.ts",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@chinasupply/config": "workspace:*",
    "eslint": "^9.39.1",
    "tsx": "^4.21.0",
    "typescript": "5.9.2",
    "vitest": "4.0.18"
  }
}
