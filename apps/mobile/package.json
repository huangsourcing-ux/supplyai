{
  "name": "@chinasupply/mobile",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo run:android",
    "check": "pnpm run doctor && pnpm run typecheck && pnpm run config:check && pnpm run export:check",
    "config:check": "expo config --type public",
    "doctor": "npx expo-doctor@latest",
    "eas:preview": "npx eas-cli@21.1.0 build --platform android --profile preview",
    "export:check": "expo export --platform ios --output-dir .expo/export-ios && expo export --platform android --output-dir .expo/export-android",
    "ios": "expo run:ios",
    "lint": "eslint .",
    "prebuild": "expo prebuild",
    "start": "expo start --dev-client",
    "test:unit": "jest --runInBand",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chinasupply/geo": "workspace:*",
    "@chinasupply/i18n": "workspace:*",
    "@chinasupply/schemas": "workspace:*",
    "@chinasupply/config": "workspace:*",
    "@clerk/expo": "4.0.1",
    "@expo/metro-runtime": "~6.1.2",
    "@maplibre/maplibre-react-native": "11.3.6",
    "@tanstack/react-query": "^5.90.19",
    "expo": "54.0.36",
    "expo-build-properties": "~1.0.10",
    "expo-crypto": "~15.0.9",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.20",
    "expo-linking": "~8.0.11",
    "expo-localization": "~17.0.8",
    "expo-router": "6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "i18next": "^25.8.0",
    "nativewind": "4.2.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^16.5.3",
    "react-native": "0.81.5",
    "react-native-css-interop": "0.2.6",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-mmkv": "~4.1.1",
    "react-native-nitro-modules": "^0.33.2",
    "react-native-reanimated": "~4.1.6",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-worklets": "^0.7.2",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@babel/core": "^7.28.6",
    "@babel/plugin-transform-react-jsx": "7.29.7",
    "@expo/config": "~12.0.13",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/geojson": "7946.0.16",
    "@types/node": "^22.19.1",
    "@types/react": "~19.1.17",
    "@types/react-dom": "19.1.11",
    "babel-preset-expo": "~54.0.9",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.16",
    "tailwindcss": "3.4.19",
    "tsx": "^4.21.0",
    "typescript": "5.9.2"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    },
    "install": {
      "exclude": [
        "react-native-worklets"
      ]
    }
  },
  "osMetadata": {
    "initVersion": "9.0.0",
    "initCommit": "a8ded50fdb41e75ec2e919ae2410bcdc2fdad0c8"
  }
