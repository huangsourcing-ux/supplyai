APP_ENV=local
NEXT_PUBLIC_APP_ENV=local
DATABASE_URL=postgresql://chinasupply:chinasupply_local_only@127.0.0.1:5432/chinasupply
PAYLOAD_SECRET=replace_me_with_at_least_32_chars
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# Replace these placeholders with credentials from the matching environment.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_MAPTILER_KEY=replace_me
NEXT_PUBLIC_SENTRY_DSN=https://public@example.ingest.sentry.io/1
SENTRY_AUTH_TOKEN=replace_me
SENTRY_ORG=replace_me
SENTRY_PROJECT=chinasupply-web
NEXT_PUBLIC_POSTHOG_KEY=phc_replace_me
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
R2_ACCOUNT_ID=replace_me
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me
R2_MEDIA_BUCKET=chinasupply-dev-media
R2_PREFIX=dev
R2_CDN_BASE_URL=http://localhost:9000
