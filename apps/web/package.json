{
  "name": "@chinasupply/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependenciesMeta": {
    "@chinasupply/api-client": {
      "injected": true
    }
  },
  "scripts": {
    "build": "next build",
    "cms:migrate": "node scripts/payload-cli.mjs migrate",
    "cms:migrate:create": "node scripts/payload-cli.mjs migrate:create",
    "cms:migrate:status": "node scripts/payload-cli.mjs migrate:status",
    "dev": "next dev",
    "generate:importmap": "node scripts/payload-cli.mjs generate:importmap",
    "generate:types": "node scripts/payload-cli.mjs generate:types",
    "lint": "eslint .",
    "prebuild": "pnpm prepare:maplibre-worker",
    "predev": "pnpm --filter @chinasupply/schemas build && pnpm --filter @chinasupply/geo build && pnpm prepare:maplibre-worker",
    "prepare:maplibre-worker": "node scripts/prepare-maplibre-worker.mjs",
    "start": "next start",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:staging": "playwright test --config playwright.staging.config.ts",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1098.0",
    "@aws-sdk/s3-request-presigner": "3.1098.0",
    "@chinasupply/analytics": "workspace:*",
    "@chinasupply/api-client": "workspace:*",
    "@chinasupply/config": "workspace:*",
    "@chinasupply/geo": "workspace:*",
    "@chinasupply/schemas": "workspace:*",
    "@clerk/nextjs": "7.5.22",
    "@payloadcms/db-postgres": "3.86.0",
    "@payloadcms/next": "3.86.0",
    "@payloadcms/richtext-lexical": "3.86.0",
    "@payloadcms/storage-s3": "3.86.0",
    "@payloadcms/ui": "3.86.0",
    "@sentry/nextjs": "10.67.0",
    "@tanstack/react-query": "^5.90.19",
    "geist": "1.7.2",
    "graphql": "16.11.0",
    "maplibre-gl": "6.0.0",
    "nanoid": "6.0.0",
    "next": "16.2.11",
    "next-intl": "4.13.3",
    "payload": "3.86.0",
    "posthog-js": "1.407.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.2",
    "vitest": "4.0.18"
  }
}
