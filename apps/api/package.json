{
  "name": "@chinasupply/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "clerk:sync-users": "node --env-file-if-exists=.env.local --enable-source-maps dist/clerk-sync-users.js",
    "db:check": "node --env-file-if-exists=.env.local ./node_modules/drizzle-kit/bin.cjs check --config=drizzle.config.ts",
    "db:generate": "node --env-file-if-exists=.env.local ./node_modules/drizzle-kit/bin.cjs generate --config=drizzle.config.ts",
    "db:migrate": "node --env-file-if-exists=.env.local ./node_modules/drizzle-kit/bin.cjs migrate --config=drizzle.config.ts",
    "dev": "pnpm dev:api",
    "dev:api": "node --env-file-if-exists=.env.local ./node_modules/@nestjs/cli/bin/nest.js start --watch --entryFile main",
    "dev:worker": "node --env-file-if-exists=.env.local ./node_modules/@nestjs/cli/bin/nest.js start --watch --entryFile worker",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "generate:load-data": "tsx scripts/generate-load-data.ts",
    "geocode:factories": "pnpm --filter @chinasupply/geo build && tsx scripts/geocode-factories.ts",
    "import:clusters": "pnpm --filter @chinasupply/geo build && tsx scripts/import-clusters.ts",
    "import:factories": "pnpm --filter @chinasupply/geo build && tsx scripts/import-factories.ts",
    "lint": "eslint .",
    "start:api": "node --env-file-if-exists=.env.local --enable-source-maps dist/main.js",
    "start:worker": "node --env-file-if-exists=.env.local --enable-source-maps dist/worker.js",
    "sentry:smoke": "node --env-file-if-exists=.env.local --enable-source-maps dist/sentry-smoke.js",
    "seed:real": "pnpm --filter @chinasupply/geo build && tsx scripts/seed-real.ts",
    "system:ping": "node --env-file-if-exists=.env.local --enable-source-maps dist/system-ping.js",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:load": "tsx scripts/run-load-tests.ts",
    "test:unit": "vitest run",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1094.0",
    "@aws-sdk/s3-request-presigner": "3.1094.0",
    "@chinasupply/config": "workspace:*",
    "@chinasupply/geo": "workspace:*",
    "@chinasupply/schemas": "workspace:*",
    "@clerk/backend": "3.12.0",
    "@nestjs/bullmq": "11.0.4",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-fastify": "11.1.28",
    "@nestjs/throttler": "6.5.0",
    "@sentry/nestjs": "10.67.0",
    "bullmq": "5.80.10",
    "csv-parse": "7.0.1",
    "drizzle-orm": "0.45.2",
    "fastify": "5.10.0",
    "ioredis": "5.8.2",
    "nanoid": "6.0.0",
    "nestjs-zod": "5.4.0",
    "pg": "8.22.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3",
    "zod-openapi": "6.0.0"
  },
  "devDependencies": {
    "@chinasupply/api-client": "workspace:*",
    "@nestjs/cli": "11.0.16",
    "@nestjs/testing": "11.1.28",
    "@types/node": "^22.19.1",
    "@types/pg": "8.20.0",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.39.1",
    "testcontainers": "11.10.0",
    "tsx": "4.21.0",
    "typescript": "5.9.2",
    "vitest": "4.0.18"
  }
}
