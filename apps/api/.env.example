APP_ENV=local
PORT=3001
DATABASE_URL=postgresql://chinasupply:chinasupply_local_only@127.0.0.1:5432/chinasupply
REDIS_URL=redis://127.0.0.1:6379
WEB_ORIGIN=http://localhost:3000
EDGE_PROXY_SECRET=local_edge_proxy_secret_not_used_123456

# Replace these placeholders with credentials from the matching environment.
CLERK_SECRET_KEY=sk_test_replace_me
# API HTTP only; the Worker does not require the Clerk webhook signing secret.
CLERK_WEBHOOK_SECRET=whsec_replace_me
R2_ACCOUNT_ID=replace_me
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me
R2_MEDIA_BUCKET=chinasupply-dev-media
R2_PRIVATE_BUCKET=chinasupply-dev
R2_PREFIX=dev
R2_CDN_BASE_URL=http://localhost:9000
# R2_ENDPOINT=http://127.0.0.1:9000
CLOUDFLARE_ZONE_ID=replace_me
CLOUDFLARE_PURGE_TOKEN=replace_me
SENTRY_DSN=https://public@example.ingest.sentry.io/1
# Optional at Worker startup; geocode:factories fails safely until configured.
AMAP_WEB_SERVICE_KEY=replace_me
# Local tests may point at a fake service. Remote environments must use the official endpoint.
# AMAP_GEOCODING_BASE_URL=http://127.0.0.1:3100/v3/geocode/geo
# Local workers do not schedule backups. Staging/production workers must set
# BACKUP_ENABLED=true and provide a dedicated public age X25519 recipient.
BACKUP_ENABLED=false
# BACKUP_AGE_RECIPIENT=age1...
# Restore drills additionally require an isolated target database.
# RESTORE_DATABASE_URL=postgresql://restore:replace_me@127.0.0.1:5433/restore
# Railway injects RAILWAY_GIT_COMMIT_SHA. Local smoke tests may instead set:
# SENTRY_RELEASE=chinasupply-api@0.0.0+dev
