{
  "name": "chinasupply-ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "api:generate": "pnpm --filter @chinasupply/schemas build && pnpm --filter @chinasupply/api generate:openapi && pnpm --filter @chinasupply/api-client generate && prettier --write --log-level warn apps/api/openapi.json packages/api-client/src/generated",
    "api:generate:check": "node scripts/check-api-generation.mjs",
    "api:runtime:check": "node scripts/check-api-runtime.mjs",
    "build": "turbo run build",
    "clerk:sync-users": "pnpm --filter @chinasupply/api build && pnpm --filter @chinasupply/api clerk:sync-users",
    "dev": "turbo run dev",
    "infra:check": "node scripts/check-infra.mjs",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "infra:up": "docker compose up -d --wait",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:load-data": "pnpm --filter @chinasupply/api generate:load-data",
    "lint": "eslint scripts && turbo run lint",
    "mobile:check": "pnpm --filter @chinasupply/schemas build && pnpm --filter @chinasupply/mobile check",
    "mobile:eas:preview": "pnpm --filter @chinasupply/mobile eas:preview",
    "release:migrate:cms": "node --env-file-if-exists=.env scripts/run-migrations.mjs cms",
    "release:migrate:core": "node --env-file-if-exists=.env scripts/run-migrations.mjs core",
    "seed:real": "pnpm --filter @chinasupply/api seed:real",
    "test:e2e": "pnpm --filter @chinasupply/schemas build && pnpm --filter @chinasupply/geo build && pnpm --filter @chinasupply/api test:e2e",
    "test:web:e2e": "pnpm --filter @chinasupply/web test:e2e",
    "test:web:e2e:staging": "pnpm --filter @chinasupply/web test:e2e:staging",
    "test:load": "pnpm --filter @chinasupply/schemas build && pnpm --filter @chinasupply/api test:load",
    "test:unit": "pnpm --filter @chinasupply/schemas build && pnpm --filter @chinasupply/geo build && turbo run test:unit",
    "typecheck": "pnpm --filter @chinasupply/schemas build && tsc --project tsconfig.scripts.json --noEmit && turbo run typecheck"
  },
  "devDependencies": {
    "@chinasupply/config": "workspace:*",
    "@types/node": "^22.19.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prettier": "3.9.6",
    "turbo": "^2.10.5",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@sentry/cli",
      "@swc/core",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
