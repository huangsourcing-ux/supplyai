{
  "name": "chinasupply-ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "infra:check": "node scripts/check-infra.mjs",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "infra:up": "docker compose up -d --wait",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint scripts && turbo run lint",
    "mobile:check": "pnpm --filter @chinasupply/mobile check",
    "mobile:eas:preview": "pnpm --filter @chinasupply/mobile eas:preview",
    "release:migrate:cms": "node --env-file-if-exists=.env scripts/run-migrations.mjs cms",
    "release:migrate:core": "node --env-file-if-exists=.env scripts/run-migrations.mjs core",
    "test:unit": "turbo run test:unit",
    "typecheck": "tsc --project tsconfig.scripts.json --noEmit && turbo run typecheck"
  },
  "devDependencies": {
    "@chinasupply/config": "workspace:*",
    "@types/node": "^22.19.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "turbo": "^2.10.5",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
