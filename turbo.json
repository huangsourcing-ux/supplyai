{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": [
    "APP_ENV",
    "AMAP_*",
    "BACKUP_*",
    "CI",
    "CLERK_SECRET_KEY",
    "CLERK_WEBHOOK_SECRET",
    "CLOUDFLARE_PURGE_TOKEN",
    "DATABASE_URL",
    "EDGE_PROXY_SECRET",
    "PORT",
    "REDIS_URL",
    "RESTORE_DATABASE_URL",
    "WEB_ORIGIN",
    "NEXT_PUBLIC_*",
    "PAYLOAD_SECRET",
    "R2_*",
    "SENTRY_*",
    "GITHUB_SHA",
    "GIT_COMMIT_SHA",
    "NEXT_RUNTIME",
    "PLAYWRIGHT_STAGING_BASE_URL",
    "PLAYWRIGHT_TEST",
    "RAILWAY_GIT_COMMIT_SHA",
    "SERVICE_ROLE",
    "VERCEL_GIT_COMMIT_SHA"
  ],
  "globalPassThroughEnv": ["PATH"],
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "build/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "test:unit": {
      "dependsOn": ["^test:unit"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    }
  }
}
